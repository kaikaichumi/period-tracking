<?xml version="1.0" encoding="utf-8"?>
<!-- Health records stay out of automatic cloud backups; users back up to
     their own Google Drive from the app instead. Device-to-device transfer
     when setting up a new phone is unaffected. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
